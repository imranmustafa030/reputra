# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Keep the database name ("reputra") before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/reputra?retryWrites=true&w=majority

# Encrypts the login cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: the domain printed on QR codes and sent in WhatsApp links, e.g. https://reputra.pk
# Leave empty to use whatever domain the dashboard is opened on.
SITE_URL=

# The first admin (the Reputra team), created by `npm run seed`. Only needed when you run the seed;
# you don't have to add these two to Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Online payments. Leave empty: owners pay by Raast / JazzCash / Easypaisa / bank transfer.
# "test" shows a pretend card checkout for trying the flow (blocked in production).
PAYMENT_GATEWAY=
